  Dialogs:
  - Name: Monty
    MainText: Hi
    EndSentencesEvetn:
      m_PersistentCalls:
        m_Calls: []
  - Name: Monty
    MainText: "I heard you are a brave adventurer\r"
    EndSentencesEvetn:
      m_PersistentCalls:
        m_Calls: []
  - Name: Monty
    MainText: I also travel a lot, because I am a merchant
    EndSentencesEvetn:
      m_PersistentCalls:
        m_Calls: []
  - Name: Monty
    MainText: Can you do me a favor
    EndSentencesEvetn:
      m_PersistentCalls:
        m_Calls: []
  - Name: Monty
    MainText: I need this bouquet for my wife in the peasant village
    EndSentencesEvetn:
      m_PersistentCalls:
        m_Calls: []
  - Name: Monty
    MainText: It's our wedding anniversary, but I won't be able to come back on time
    EndSentencesEvetn:
      m_PersistentCalls:
        m_Calls: []
