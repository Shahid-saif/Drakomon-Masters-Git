        m_Calls: []
  - Name: Monty's Wife
    MainText: I'm waiting for my husband, Monty
    EndSentencesEvetn:
      m_PersistentCalls:
        m_Calls: []
  - Name: Monty's Wife
    MainText: Usually my husband does not forget our wedding anniversary
    EndSentencesEvetn:
      m_PersistentCalls:
        m_Calls: []
  - Name: Monty's Wife
    MainText: If he can't come home, he sends me a bouquet.
    EndSentencesEvetn:
      m_PersistentCalls:
        m_Calls: []
